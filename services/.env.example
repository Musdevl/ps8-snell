# Copier en `services/.env` — docker compose le lit automatiquement.
# Ne jamais committer le .env rempli.

# ── Liens envoyés par mail ───────────────────────────────────────────────────
# URL par laquelle un navigateur atteint la gateway depuis l'extérieur.
# Sans nom de domaine, c'est l'IP publique du VPS.
PUBLIC_GATEWAY_URL=http://123.45.67.89:8000

# ── SMTP ─────────────────────────────────────────────────────────────────────
# Option A — Brevo (recommandé) : 300 mails/jour gratuits, expéditeur validable
# sur une simple adresse perso, donc aucun nom de domaine requis.
#   1. Créer un compte sur brevo.com
#   2. Senders & IP > ajouter ton adresse perso comme expéditeur, valider le mail reçu
#   3. SMTP & API > générer une clé SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton-identifiant-brevo
SMTP_PASS=ta-cle-smtp-brevo
MAIL_FROM=Snell <ton-adresse-validee@gmail.com>

# Option B — Gmail : 500 mails/jour, nécessite la 2FA puis un mot de passe
# d'application (myaccount.google.com > Sécurité > Mots de passe d'application).
# Délivrabilité moins bonne : plus de risque de spam.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ton-adresse@gmail.com
# SMTP_PASS=mot-de-passe-application-16-caracteres
# MAIL_FROM=Snell <ton-adresse@gmail.com>

# ── Stripe (déjà utilisé par le user service) ────────────────────────────────
# STRIPE_SECRET_KEY=
